@page "/users"

@attribute [Authorize(Policy = "AdminOnly")]

<h3>Users Details</h3>

@using MeetingPlanner.Services
@using MeetingPlanner.Auth
@using Microsoft.AspNetCore.Authorization

<MudTable 
    T="AppUser"
    Items="@users">
    <HeaderContent>
        <MudTh>Username</MudTh>
        <MudTh>Password</MudTh>
        <MudTh>Role</MudTh>
        <MudTh>Deactivate user</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTh>@context.Username</MudTh>
        <MudTh>@context.Password</MudTh>
        <MudTh>@context.Role</MudTh>

        <MudTh>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #C998ED;"
                       @onclick="@(() => DeactivateUser(context.Username))">
                       Deactivate
            </MudButton>
        </MudTh>
    </RowTemplate>
</MudTable>

<br/>
<br/>

@if (_messageAlert != string.Empty)
{
    <MudAlert 
        Severity="Severity.Warning"
        Variant="Variant.Outlined">
        @_messageAlert
    </MudAlert>
}

@code {
    [Inject]
    private InMemoryAuthService _authService { get; set; } 

    private string _messageAlert = string.Empty; 
    public List<AppUser> users = new(); 

    protected override void OnInitialized()
    {
        users = _authService.GetUsers(); 
    }

    private void DeactivateUser(string username)
    {
        _messageAlert = "Deactivate user: " + username;
        StateHasChanged();
    }
}
