@page "/users"

@attribute [Authorize(Policy = "AdminOnly")]

<h3>Users Details</h3>

@using MeetingPlanner.Services
@using MeetingPlanner.Models
@using MeetingPlanner.Auth
@using Microsoft.AspNetCore.Authorization

<MudTable 
    T="AppUser"
    Items="@users">
    <HeaderContent>
        <MudTh>Username</MudTh>
        <MudTh>Password</MudTh>
        <MudTh>Role</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTh>@context.Username</MudTh>
        <MudTh>@context.Password</MudTh>
        <MudTh>@context.Role</MudTh>
    </RowTemplate>
</MudTable>

@code {
    [Inject]
    private InMemoryAuthService _authService { get; set; }

    public List<AppUser> users = new(); 

    protected override void OnInitialized()
    {
        users = _authService.GetUsers(); 
    }
}
