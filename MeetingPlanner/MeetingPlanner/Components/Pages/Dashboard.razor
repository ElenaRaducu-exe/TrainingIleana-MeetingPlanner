@page "/dashboard"

@using Microsoft.AspNetCore.Authorization

@using MeetingPlanner.Services
@using MeetingPlanner.Models

<h1>Dashboard</h1>

<p>Coming soon...</p>

<p>Overview of all meetings</p>

<!-- Hover="true" -->
<MudTable 
    T="MeetingSummary"
    Items="@MeetingsSummaries"
    Hover="@hover" 
    Striped="@striped"
    Filter="@FilterFunction">
        <ToolBarContent>
            <MudTextField
                @bind-Value="searchString"
                Placeholder="Search for project..."
                Adornment="Adornment.Start" 
                AdornmentIcon="@Icons.Material.Filled.Search"></MudTextField>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Participants</MudTh>
            <MudTh>ProjectID</MudTh>
            <MudTh>
                <MudTableSortLabel 
                    T="MeetingSummary"
                    SortBy="@(x => x.ProjectName)">
                            ProjectName
                </MudTableSortLabel>
            </MudTh>
            <MudTh>ProjectDescription</MudTh>
            <MudTh>Delete Meeting</MudTh>
            <MudTh>Edit Meeting</MudTh>
        </HeaderContent>

    <RowTemplate>
                <MudTh>@context.Id</MudTh>
                <MudTh>@context.Title</MudTh>
                <MudTh>@context.Date</MudTh>
                <MudTh>
                    @foreach(var participant in context.Participants)
                    {
                        <p>@participant</p> 
                    }
                </MudTh>
                <MudTh>@context.ProjectId</MudTh>
                <MudTh>@context.ProjectName</MudTh>
                <MudTh>@context.ProjectDescription</MudTh>
                <MudTh>
                    <MudButton Variant="Variant.Filled" 
                        Style="background-color: #C998ED;"
                        @onclick = "@(() => DeleteMeeting(context.Id))">
                        Delete
                    </MudButton>
                </MudTh>
                <MudTh>
                    <MudButton Variant="Variant.Filled" 
                        Style="background-color: #C998ED;"
                        @onclick = "@(() => EditMeetingDialog(context))">
                        Edit
                    </MudButton>
                </MudTh>
    </RowTemplate>
</MudTable>

<MudToolBar>
    <MudSwitch @bind-Value="hover" Color="Color.Primary">Hover</MudSwitch>
    <MudSwitch @bind-Value="striped" Color="Color.Tertiary">Striped</MudSwitch>
</MudToolBar>

@code {
    [Inject]
    private IMeetingService _meetingService { get; set; }

    [Inject]
    private IDialogService _dialogService { get; set; }

    [Inject]
    private IJSRuntime _jRuntime { get; set; }

    private bool hover = false; 
    private bool striped = false;
    private string searchString = String.Empty; 

    public List<MeetingSummary> MeetingsSummaries = new();
    public MeetingSummary meetingSummary { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        MeetingsSummaries = await _meetingService.GetMeetingSummaries();
    }

    private bool FilterFunction(MeetingSummary meetingSummary)
    {
        if(string.IsNullOrWhiteSpace(searchString) == true 
                || meetingSummary.ProjectName.Contains(searchString) == true)
        {
            return true; 
        }

        return false; 
    }

    private async void DeleteMeeting(int idMeetingForDeleting)
    {
        bool confirmDetele = await _jRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to detele the meeting?");
        if (confirmDetele)
        {
            _meetingService.DeteleMeetingAsync(idMeetingForDeleting);
        }
    }


    private Task EditMeetingDialog(MeetingSummary meetingSummary)
    {

        var parameters = new DialogParameters
        {
            {"meetingDetails", meetingSummary}
        };

        //return _dialogService.ShowAsync<DialogEditFormMeeting>("Edit meeting", parameters);
        //var options = new DialogOptions { CloseOnEscapeKey = true };
        return _dialogService.ShowAsync<DialogEditFormMeeting>("Edit meeting", parameters);
    }
}