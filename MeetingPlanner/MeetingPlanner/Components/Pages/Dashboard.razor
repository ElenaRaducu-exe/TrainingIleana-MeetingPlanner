    private async Task ShowDeleteConfirmation(int idMeetingForDeleting)
    {

        var parameters = new DialogParameters
            {
                {nameof(DeleteConfirmationDialog.Title), "Delete meeting confirmation"}, 
                {"Message", "Are you sure you want to proceed with deteleting this meeting?"},
                {"OnConfirm", EventCallback.Factory.Create<int>(this, () => ConfirmDelete(idMeetingForDeleting))}
            };

            await _dialogService.ShowAsync<DeleteConfirmationDialog>("Delete Confirmation", parameters); 
    }

    private async Task EditMeetingDialog(MeetingSummary meetingSummary)
    {
        var parametersMeetingSummary = new DialogParameters
        {
            {"meetingDetails", meetingSummary}
        };

        var dialog = await _dialogService.ShowAsync<DialogEditFormMeeting>("Edit meeting", parametersMeetingSummary);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadMeetingsSummaries(); // reincarcarea datelor
        }
    }

    private async Task ConfirmDelete(int id)
    {
        await _meetingService.DeteleMeetingAsync(id);
        await LoadMeetingsSummaries();
    }
}