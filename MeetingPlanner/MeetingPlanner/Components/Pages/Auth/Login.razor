@page "/login" 

@inject CustomAuthStateProvider authProvider
@inject NavigationManager navigation

@using MeetingPlanner.Services
@using MeetingPlanner.Auth

<h1>Login Page</h1>

<MudForm>
    <MudTextField 
        T="string"
        Label = "Username"
        Required="true"
        RequiredError ="Email is required!"
        @bind-value = "username">
    </MudTextField>

    <MudTextField 
        T="string"
        Label = "Password"
        Required="true"
        RequiredError ="Password is required!"
        InputType ="InputType.Password"
        @bind-value = "password">
    </MudTextField>
</MudForm>

<MudButton Variant="Variant.Filled" 
           Style="background-color: #C998ED;"
           @onclick = "@HandleLogin">
    Login
</MudButton>

@if (failMessage != null)
{
    <p>@failMessage</p>
}

@code {
    private string username;
    private string password;
    private string failMessage = string.Empty; 

    private void HandleLogin()
    {
        bool success = authProvider.Login(username, password);

        if (success)
        {
            navigation.NavigateTo("/dashboard"); 
        }
        else
        {
            failMessage = "Invalid credentials!";
        }
    }
}
