@page "/meetings/{meetingId:int}"

@using MeetingPlanner.Classes
@using MeetingPlanner.Services
@using MeetingPlanner.Models

@inject NavigationManager navigation
@inject IMeetingService iMeetingService

<button type="button" @onclick="NavigateBack">BACK</button>

<br />
<br />

<!--
@{
    // nerecomandat - ce este in afara sectiunii @code se re-randeaza la fiecare StateHasChanged
    var meetingItem = meetingService.GetMeetingCardByID(selectedId);
}
-->

<ProjectBadge 
    Id="@projectItem.Id"
    Name="@projectItem.Name"
    Description="@projectItem.Description"/>

<MeetingCard Id="@meetingItem.Id"
             Title="@meetingItem.Title"
             Date="@meetingItem.Date"
             ProjectID="@meetingItem.ProjectID" 
             Participants="@meetingItem.Participants"/>

@code {
    [Parameter]
    public int meetingId { get; set; }

    public Meeting? meetingItem;
    public Project? projectItem; 

    protected override async Task OnParametersSetAsync()
    {
        meetingItem = await iMeetingService.GetMeetingByIdAsync(meetingId);
        projectItem = await iMeetingService.GetProjectByIdAsync(meetingItem.ProjectID);
    }

    private void NavigateBack()
    {
        navigation.NavigateTo($"/meetings");
    }
}
