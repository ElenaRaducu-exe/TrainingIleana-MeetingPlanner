@page "/meetings/{meetingId:int}"

@attribute [Authorize(Roles = "user,admin")]

@using MeetingPlanner.Classes
@using MeetingPlanner.Services
@using MeetingPlanner.Models

@implements IDisposable

<MudButton Variant="Variant.Filled" 
           Style="background-color: #C998ED;"
           @onclick = "@NavigateBack">
    BACK
</MudButton>

<MudButton Variant="Variant.Filled" 
           Style="background-color: #C998ED;"
           @onclick = "@CopyMeetingLink">
    Copy meeting link
</MudButton>

<br />
<br />

<!--
@{
    // nerecomandat - ce este in afara sectiunii @code se re-randeaza la fiecare StateHasChanged
    var meetingItem = meetingService.GetMeetingCardByID(selectedId);
}
-->

<ProjectBadge 
    Id="@projectItem.Id"
    Name="@projectItem.Name"
    Description="@projectItem.Description"/>

<MeetingCard Id="@meetingItem.Id"
             Title="@meetingItem.Title"
             Date="@meetingItem.Date"
             ProjectID="@meetingItem.ProjectID" 
             Participants="@meetingItem.Participants"/>

@if(_showNotification == true)
{
    <p>Link copied! - @_meetingLink</p>
}

@if (_showBanner == true)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Time to join your meeting!</MudAlert>
}

@code {
    [Inject]
    private IJSRuntime _jSRuntime { get; set; }

    [Inject]
    private IMeetingService _meetingService { get; set; }

    [Inject]
    private NavigationManager _navigationManager { get; set; }

    [Parameter]
    public int meetingId { get; set; }

    public Meeting? meetingItem;
    public Project? projectItem; 

    private string _meetingLink = string.Empty;
    private bool _showNotification = false;

    private DotNetObjectReference<MeetingDetailsPage>? dotNetRef;
    private IJSObjectReference? module;
    private bool _showBanner = false; 

    protected override void OnInitialized()
    {
        _meetingLink = _navigationManager.Uri; 
    }

    protected override async Task OnParametersSetAsync()
    {
        meetingItem = await _meetingService.GetMeetingByIdAsync(meetingId);
        projectItem = await _meetingService.GetProjectByIdAsync(meetingItem.ProjectID);
    }

    private void NavigateBack()
    {
        _navigationManager.NavigateTo($"/meetings");
    }

    private async Task CopyMeetingLink()
    {
        await _jSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _meetingLink);

        await ShowNotification();
    }

    private async Task ShowNotification()
    {
        _showNotification = true;
        StateHasChanged();

        await Task.Delay(2000); 

        _showNotification = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        dotNetRef = DotNetObjectReference.Create(this);
        module = await _jSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/countdown.js");
        await module.InvokeAsync<IJSObjectReference>("startCountdown", dotNetRef, 3);
    }

    [JSInvokable]
    public void CountDownFinished()
    {
        _showBanner = true;
        StateHasChanged(); 
    }

    void IDisposable.Dispose()
    {
        dotNetRef?.Dispose();
    }
}