@page "/projects"

@attribute [Authorize(Roles = "user,admin")]

@using MeetingPlanner.Services
@using MeetingPlanner.Components
@using MeetingPlanner.Classes
@using MeetingPlanner.Models

@inject MeetingStateService meetingStateService
@inject IMeetingService iMeetingService

<h1>Projects</h1>

<p>List of projects</p>

<button type="button" @onclick="@UndoSelectedProject">Undo project selection</button>

<br/> 
<br/> 

@foreach(var project in projectList)
{
    <ProjectBadge 
        Id="@project.Id" 
        Name="@project.Name"
        Description="@project.Description"
        OnSelected = "@SelectedProject"/>
}

<p>Id-ul proiectului selectat este: @meetingStateService.SelectedProjectId</p>

<div class="meeting-component">
    <Meetings></Meetings>
</div>

<style>
    .meeting-component{
        border: 3px solid #444348;
        margin-bottom: 25px;
        padding: 35px;
        background-color: #C4C2CF;
    }
</style>

@code {
    private List<Project> projectList = []; 

    protected override async Task OnInitializedAsync()
    {
        projectList = await iMeetingService.GetProjectsAsync();
    }

    private void SelectedProject(int id)
    {
        meetingStateService.SetProject(id);
    }

    private void UndoSelectedProject()
    {
        meetingStateService.ClearSelection();
    }
}
