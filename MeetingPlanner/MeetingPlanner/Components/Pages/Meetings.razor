@page "/meetings"

@inject NavigationManager navigation
@inject MeetingsService meetingService
@inject ProjectsService projectsService
@inject MeetingStateService meetingStateService

@using MeetingPlanner.Services
@using MeetingPlanner.Classes

@implements IDisposable

<h1>Meetings</h1>

<br/> 
<br/> 

<p>List of meetings</p>

@if (selectedProject == null)
{
    <p>Nu s-a selectat niciun proiect!</p>
}
else
{
    <p>Proiectul selectat este: @selectedProject.ProjectName</p>
}

@foreach (var meetingItem in meetingService.getMeetings())
{
    var projectItem = projectsService.GetProjectById(meetingItem.ProjectId);

    if(projectItem != null){
     <ProjectBadge 
        ProjectId = "@projectItem.ProjectId"
        Name="@projectItem.ProjectName"  />
        <br />
    

    <MeetingCard 
        Id = "@meetingItem.Id"
        MeetingName="@meetingItem.MeetingTitle"
        Date="@meetingItem.Date"
        ProjectId="@meetingItem.ProjectId"
        ProjectName="@projectItem.ProjectName"
        OnSelectedId = "SelectMeetingId"  />
    }
}

@code {
    private string? selectedMeetingName { get; set; }  
    private int selectedId { get; set; }  

    private MeetingItem? selectedItem { get; set; }
    private ProjectItem? selectedProject; 

    /*
    private void SelectedMeetingName(string title)
    {
        selectedMeetingName = title;
        //navigation.NavigateTo($"/meetings/{selectedMeetingName}");
        }*/

    private void SelectMeetingId(int id)
    {
        selectedId = id;
        navigation.NavigateTo($"/meetings/{selectedId}");
        //meetingService.GetMeetingCardByID(selectedId);
    }

    // actualizeaza selectedProject 
    private void LoadSelectedProject()
    {
        if(meetingStateService.SelectedProjectId.HasValue)
        {
            int id = meetingStateService.SelectedProjectId.Value;
            selectedProject = projectsService.GetProjectById(id);
        }
    }

    // se executa cand se incarca pagina (componenta) Meetings
    protected override void OnInitialized()
    {
        // componneta s-a abonat la evenimentul OnChange 
        meetingStateService.OnChange += HandleStateChanged; 
        LoadSelectedProject();
    }

    // metoda executa cand se declanseaza OnChange
    private void HandleStateChanged()
    {
        LoadSelectedProject();

        // re-randarea componentei -> actualizarea interfetei 
        StateHasChanged(); 
    }

    public void Dispose()
    {
        meetingStateService.OnChange -= HandleStateChanged;
    }
}
