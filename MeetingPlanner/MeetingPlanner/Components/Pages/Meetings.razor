@page "/meetings"

@inject NavigationManager navigation
@inject MeetingStateService meetingStateService
@inject IMeetingService iMeetingService

@using MeetingPlanner.Services
@using MeetingPlanner.Classes
@using MeetingPlanner.Models 

@implements IDisposable 

<h1>Meetings</h1>

<br/> 
<br/> 

<p>List of meetings</p>

@if (selectedProject == null)
{
    <p>Nu s-a selectat niciun proiect!</p>
}
else
{
    <p>Proiectul selectat este: @selectedProject.Name</p>
}

@foreach (var meeting in meetingList)
{
    <MeetingCard 
        Id = "@meeting.Id"
        Title="@meeting.Title"
        Date="@meeting.Date"
        ProjectID="@meeting.ProjectID"
        Participants="@meeting.Participants"
        OnSelectedId = "SelectMeetingId"  />
}

@code {
    private int selectedId { get; set; }  
    private Meeting? selectedItem { get; set; }
    private Project? selectedProject;
    private List<Meeting> meetingList = []; 

    protected override void OnInitialized()
    {
        // componneta s-a abonat la evenimentul OnChange 
        meetingStateService.OnChange += HandleStateChanged;
        LoadSelectedProject();
    }

    protected override async Task OnInitializedAsync()
    {
        if (selectedProject == null)
        {
            meetingList = await iMeetingService.GetMeetingsAsync();
        }
        else
        {
            meetingList = await iMeetingService.GetMeetingsByProjectAsync(selectedProject.Id);
        }
    } 

    private void SelectMeetingId(int id)
    {
        selectedId = id;
        navigation.NavigateTo($"/meetings/{selectedId}");
    }

    // actualizeaza selectedProject 
    private async void LoadSelectedProject()
    {
        if(meetingStateService.SelectedProjectId.HasValue)
        {
            int id = meetingStateService.SelectedProjectId.Value;
            selectedProject = await iMeetingService.GetProjectByIdAsync(id);
        }
    }

    // metoda executa cand se declanseaza OnChange
    private async void HandleStateChanged()
    {
        LoadSelectedProject();
        
        meetingList = await iMeetingService.GetMeetingsByProjectAsync(selectedProject.Id);

        // re-randarea componentei -> actualizarea interfetei 
        StateHasChanged(); 
    }

    public void Dispose()
    {
        meetingStateService.OnChange -= HandleStateChanged;
    }
}
