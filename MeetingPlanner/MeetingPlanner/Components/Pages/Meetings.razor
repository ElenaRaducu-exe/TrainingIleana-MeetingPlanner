@page "/meetings"

@attribute [Authorize(Roles = "user,admin")]

@using MeetingPlanner.Services
@using MeetingPlanner.Services.Contracts
@using MeetingPlanner.Classes
@using MeetingPlanner.Models 
@using MeetingPlanner.Components.Pages.Dialogs

@implements IDisposable 

<h1>Meetings</h1>

<br/> 
<br/> 

<MudButton
    @onclick="OpenDialogAsync"
    Color="Color.Primary">
    Add new meeting
</MudButton>

<button type="button" 
        class="btn-navigate-form" 
        @onclick="@NavigateNewMeetingForm">Create a new meeting</button>

<br />
<br />

<p>List of meetings</p>

@if (selectedProject == null)
{
    <p>Nu s-a selectat niciun proiect!</p>
}
else
{
    <p>Proiectul selectat este: @selectedProject.Name</p>
}

@foreach (var meeting in meetingList)
{
    <MeetingCard 
        Id = "@meeting.Id"
        Title="@meeting.Title"
        Date="@meeting.Date"
        ProjectID="@meeting.ProjectID"
        Participants="@meeting.Participants"
        OnSelectedId = "@SelectMeetingId"  />
}

@code {
    [Inject]
    private IDialogService _dialogService { get; set; }

    [Inject]
    private NavigationManager _navigationManager { get; set; }

    [Inject]
    private MeetingStateService _meetingStateService { get; set; }

    [Inject]
    private IMeetingService _meetingService { get; set; }

    private int selectedId { get; set; }  
    private Meeting? selectedItem { get; set; }
    private Project? selectedProject;
    private List<Meeting> meetingList = []; 

    protected override void OnInitialized()
    {
        // componneta s-a abonat la evenimentul OnChange 
        _meetingStateService.OnChange += HandleStateChanged;
        LoadSelectedProject();
    }

    protected override async Task OnInitializedAsync()
    {
        if (selectedProject == null)
        {
            meetingList = await _meetingService.GetMeetingsAsync();
        }
        else
        {
            meetingList = await _meetingService.GetMeetingsByProjectAsync(selectedProject.Id);
        }
    } 

    private void SelectMeetingId(int id)
    {
        selectedId = id;
        _navigationManager.NavigateTo($"/meetings/{selectedId}");
    }

    // actualizeaza selectedProject 
    private async void LoadSelectedProject()
    {
        if(_meetingStateService.SelectedProjectId.HasValue)
        {
            int id = _meetingStateService.SelectedProjectId.Value;
            selectedProject = await _meetingService.GetProjectByIdAsync(id);
        }
        else
        {
            selectedProject = null;
        }
    }

    // metoda executa cand se declanseaza OnChange
    private async void HandleStateChanged()
    {
        LoadSelectedProject();

        if (selectedProject == null)
        {
            meetingList = await _meetingService.GetMeetingsAsync();
        }
        else 
        {
            meetingList = await _meetingService.GetMeetingsByProjectAsync(selectedProject.Id);
        }

        // re-randarea componentei -> actualizarea interfetei 
        StateHasChanged(); 
    }

    public void Dispose()
    {
        _meetingStateService.OnChange -= HandleStateChanged;
    }

    private void NavigateNewMeetingForm()
    {
        _navigationManager.NavigateTo("/meetings/new");
    }

    private Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return _dialogService.ShowAsync<DialogFormNewMeeting>("Simple Dialog", options);
    }
}
