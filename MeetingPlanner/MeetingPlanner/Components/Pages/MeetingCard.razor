@inject NavigationManager navigation

<div class="meeting-card" @onclick="CardClicked">
    <h3>@MeetingName</h3>

    @if(Date.Date == DateTime.Today)
    {
        <span class="today-label">TODAY</span>
        <p>Date: @Date.ToString("dd MMM yyyy")</p>
    }
    else
    {
        <p>Date: @Date.ToString("dd MMM yyyy")</p>
    }

    <p>ID proiect: @projectId</p>
    <p>Nume proiect: @ProjectName</p>

</div>

<style>
    .meeting-card{
        border: 3px solid #2B2B8F;
        margin-bottom: 25px;
        padding: 35px;
        background-color: #A1A1E3;
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public string MeetingName { get; set; } = string.Empty; 

    [Parameter]
    public DateTime Date { get; set; }

    [Parameter]
    public int projectId { get; set; }

    [Parameter]
    public string ProjectName { get; set; } = string.Empty;

    [Parameter]
    public string ProjectColor { get; set; }

    [Parameter]
    public EventCallback<int> OnSelectedId { get; set; } 

    private async Task CardClicked()
    {
        await OnSelectedId.InvokeAsync(Id);
    }
}