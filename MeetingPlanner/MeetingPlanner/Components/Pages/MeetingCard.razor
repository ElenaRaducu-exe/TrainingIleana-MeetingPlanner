@inject NavigationManager navigation

<div class="meeting-card" @onclick="CardClicked">
    <h3>@Title</h3>

    @if(Date.Date == DateTime.Today)
    {
        <p>TODAY: Date: @Date.ToString("dd MMM yyyy")</p>
    }
    else
    {
        <p>Date: @Date.ToString("dd MMM yyyy")</p>
    }

    <p>ID proiect: @ProjectID</p>

    <p>Participants:  </p>
    @foreach(var participant in Participants)
    {
        <p>@participant </p>
    }

</div>

<style>
    .meeting-card{
        border: 3px solid #2B2B8F;
        margin-bottom: 25px;
        padding: 35px;
        background-color: #A1A1E3;
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty; 

    [Parameter]
    public DateTime Date { get; set; }

    [Parameter]
    public int ProjectID { get; set; }

    [Parameter]
    public List<string> Participants { get; set; }

    [Parameter]
    public EventCallback<int> OnSelectedId { get; set; } 

    private async Task CardClicked()
    {
        await OnSelectedId.InvokeAsync(Id);
    }
}