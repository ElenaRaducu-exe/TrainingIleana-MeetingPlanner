@using System.Reflection 
@using System.ComponentModel.DataAnnotations

@using MeetingPlanner.Classes
@using MeetingPlanner.Models

<MudDialog>
    <TitleContent>
        New Meeting Form
    </TitleContent>

    <DialogContent>
        <MudTextField 
            @bind-value = "_newMeetingModel.Title"
            Label="Title"
            Required="true"
            RequiredError="Title is required"/>

        <MudDatePicker
            @bind-value = "_newMeetingModel.Date"
            Label="Date"
            Required="true"
            RequiredError="Date is required" 
                       Validation="@ValidateDate" />

        <MudSelect 
            T="int"
            @bind-value = "_newMeetingModel.ProjectID"
            Label="ProjectID"
            Required="true"
            RequiredError="ProjectID is required">
            @foreach (var project in _projects)
            {
                <MudSelectItem value="@project.Id">
                    @project.Id
                </MudSelectItem>
            }
        </MudSelect>

        <MudTextField 
            @bind-value = "_newMeetingModel.Participants"
            Label="Participants"
            Required="true"
            RequiredError="Participants are required" />

    </DialogContent>

    <DialogActions>
        <MudButton 
            OnClick="Cancel">Cancel
        </MudButton>

        <MudButton 
            Color="Color.Primary"
            Disabled="@(!IsFormValid())"
            OnClick="@AddMeeting">Add new meeting
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance _mudDialog { get; set; }

    [Inject]
    private IDialogService _dialogService { get; set; }

    [Inject]
    private IMeetingService _meetingService { get; set; }

    [Inject]
    private NavigationManager _navigation { get; set; }

    private NewMeetingModel _newMeetingModel = new();
    private List<Project> _projects = new();
    private Meeting _newMeeting = new();

    private async Task AddMeeting()
    {
        _newMeeting = new()
            {
                Id = _meetingService.GetLastMeetingID() + 1,
                Title = _newMeetingModel.Title,
                Date = _newMeetingModel.Date.Value,
                ProjectID = _newMeetingModel.ProjectID,
                Participants = _newMeetingModel.ConvertToList()
            };

        await _meetingService.AddMeetingAsync(_newMeeting);

        var parameters = new DialogParameters
        {
            {nameof(NewMeetingDetailsDialog.meeting), _newMeeting}
        };

        await _dialogService.ShowAsync<NewMeetingDetailsDialog>("Meeting details", parameters);
        //_navigation.NavigateTo("/meetings");
        _mudDialog.Close(DialogResult.Ok(true)); 
    }

    private void Cancel()
    {
        _mudDialog.Cancel();
    }

    protected override async Task OnInitializedAsync()
    {
        _projects = await _meetingService.GetProjectsAsync();
    }

    private bool IsFormValid()
    {
        if (!string.IsNullOrWhiteSpace(_newMeetingModel.Title) 
                && !string.IsNullOrWhiteSpace(_newMeetingModel.Participants) 
                && _newMeetingModel.Date.HasValue 
                && _newMeetingModel.ProjectID > 0)
        {
            return true;
        }
        return false;
    }

    private string? ValidateDate(DateTime? dateForm)
    {
        if (dateForm.HasValue && dateForm < DateTime.Today)
        {
            return "Date cannot be in the past!";
        }
        return null; 
    }
}