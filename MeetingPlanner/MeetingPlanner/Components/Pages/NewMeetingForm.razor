@page "/meetings/new"

@attribute [Authorize(Roles = "user")]

@inject IMeetingService iMeetingService
@inject NavigationManager navigation

@using System.Reflection 
@using System.ComponentModel.DataAnnotations

@using MeetingPlanner.Classes
@using MeetingPlanner.Models

<h3>Form for creating a new meeting</h3>
<div class="editForm-addNewMeeting">
<EditForm Model="@newMeeting"
          OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator /> 

    <div>
        <label>Title:</label>
        <InputText @bind-value = "newMeeting.Title" 
                   placeholder = "@GetPrompt(nameof(NewMeetingModel.Title))"/>
        <ValidationMessage For="@(() => newMeeting.Title)" />
    </div>

    <div>
        <label>Date:</label>
        <InputDate @bind-value = "newMeeting.Date" />
        <ValidationMessage For="@(() => newMeeting.Date)" />
    </div>

    <div>
        <label>Project ID:</label>
        <InputSelect @bind-value = "newMeeting.ProjectID">
            <option> -- Select a project ID -- </option>
            @foreach(var project in projects){
                <option value="@project.Id">@project.Id</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => newMeeting.ProjectID)" />
    </div>

    <div>
        <label>Participants:</label>
        <InputText @bind-value = "newMeeting.Participants" 
                   placeholder = "@GetPrompt(nameof(NewMeetingModel.Participants))"/>
        <ValidationMessage For="@(() => newMeeting.Participants)" />
    </div>

    <br />
    <button type="submit">Add new meeting</button>
    <br />

</EditForm>
</div>

<br />
<br />
<br />

@if (submitted)
{
    <p>
        <MeetingCard 
            Id ="@newMeetingToAdd.Id"
            Title="@newMeeting.Title"
            Date="@newMeeting.Date"
            ProjectID="@newMeeting.ProjectID"
            Participants="@newMeeting.ConvertToList()"/>

            <p>Redirecting to the meetings page...</p>
    </p>
}

@code {
    private NewMeetingModel newMeeting = new();
    private bool submitted = false;
    private Meeting newMeetingToAdd = new(); 

    private async void HandleValidSubmit()
    {
        submitted = true;

        newMeetingToAdd = new()
            {
                Id = iMeetingService.GetLastMeetingID() + 1,
                Title = newMeeting.Title,
                Date = newMeeting.Date,
                ProjectID = newMeeting.ProjectID,
                Participants = newMeeting.ConvertToList()
            };

        iMeetingService.AddMeetingAsync(newMeetingToAdd);


        await Task.Delay(2000);
        navigation.NavigateTo("/meetings"); 
    }

    private string GetPrompt(string propertyName)
    {
        var prop = typeof(NewMeetingModel).GetProperty(propertyName);
        var displayAttr = prop?.GetCustomAttribute<DisplayAttribute>();
        return displayAttr?.Prompt ?? string.Empty; 
    }

    private List<Project> projects = new();

    protected override async Task OnInitializedAsync()
    {
        projects = await iMeetingService.GetProjectsAsync();
    }
}
