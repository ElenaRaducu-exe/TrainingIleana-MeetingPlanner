@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            <a href="https://github.com/ElenaRaducu-exe/TrainingIleana-MeetingPlanner" target="_blank">Github Repo</a>
